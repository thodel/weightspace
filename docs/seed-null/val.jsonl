{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_41", "text": "Cristus desshalb, sye, das", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_42", "text": "♂", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_43", "text": "haben, das", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_44", "text": "ernig Hoügt der kilchen, Ich hab über", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_45", "text": "der usszlichn regierung halb alls Ich", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_46", "text": "+ genug", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_47", "text": "oder Dögen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_48", "text": "schrifft", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_49", "text": "Hoff, Jn dis vn zweyen ein", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_50", "text": "gen spruchen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_51", "text": "unnd mitt disem dritten darzu", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_52", "text": "Die würd Ich geben die Schlüssell", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_53", "text": "der Himmell, unnd weyd mine Schäfflin", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_54", "text": "das", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_55", "text": "Ouch den , Ew. Cristus vnnser Heiland", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_56", "text": "zu Allen sinen fungern # gesagt nach", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0050/tr_1_tl_57", "text": "siner ufferständt nüssen Joannis am letsten", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_1", "text": "Bychtvatter zu der Insell/", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_2", "text": "Nach sollichen der Bychtvatter / geantwort/", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_3", "text": "In dinem namen suͤsser her Jhesu/", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_4", "text": "erwuͤrdigen wysen guͤnstigen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_5", "text": "lieben Herrn  gestern hab", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_6", "text": "ich  das erst", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_7", "text": "das", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_8", "text": "Ich /", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_9", "text": "meynung/  hab das  Herr Berchtoldt", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_10", "text": "jetz gemeldett hatt der Dienstbarkeyt halb X gemeldet", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_11", "text": "X oder diener wie sie sich diener nämmen / ge//", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_13", "text": "nuͦg samcklich verantwurt/ so  thuͦtts", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_15", "text": "ein kuͤng ouͦch /  ist dannocht ein kuͤng /", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_17", "text": "Ist nützit unzimlichs / noch unmöglichst", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_21", "text": "dahar bracht / ob schon einer ist oder  genampt", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_23", "text": "wuͤrdt ein obrer / vnnd ein unnderthan", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_24", "text": "zuͦverglychen nitt gegen Eim / Ein", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_25", "text": "Herzog Jn einem kuͤnigrich / mag genant", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_26", "text": "werden / ein unnderthan / Er ist auch ein oberer", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_27", "text": "zuzuͦverglichett den Küͤng / So Ist er ein", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_28", "text": "underthan̄ / verglychnett gegen sinen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_29", "text": "unnderthanen luͤtten / So Ist er ein oberer /", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_30", "text": "vnnd wurdt genampt ein houͦpt / das", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_31", "text": "Ist eins / Uff das ander  zeantwuͦrtten,", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_32", "text": "ist im mir nitt moglich / wenn", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_33", "text": "Glouͦb auch / das wenigen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_34", "text": "das vermögen moglich /ordentlich +", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_35", "text": "+ in das houpt zu fassen zuͦverantworten moͤchten +", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_36", "text": "unbedacht  zuverantwurtten /", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_37", "text": "Begertt zu vern Nun sind der gruͤnd/ und", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_38", "text": "Ursachen harnach volgend  so viel / das Im ++", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_39", "text": "++ ich sie nitt wol behalten kann mag /", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_40", "text": "nit moglich sollichs jetz zeverantwurten", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_41", "text": "Begert von den", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_43", "text": "Begert aber Zytt von den predicanten /Specifi //", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_44", "text": "cationen sich zuͦ bedenken/", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_45", "text": "das ihm die predicanten", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_46", "text": "solichs  nochmals offenen darnach aber wölle er", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_47", "text": "darnach abermals antwurtten #", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_54", "text": "+", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_66", "text": "Daruff Herr Berchtold / +++", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_67", "text": "Es hatt", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_68", "text": "+++ frommen Christen  ein kuͤrtzen bescheid", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_69", "text": "Die glychnuͤsß", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_70", "text": "fuͤr", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_71", "text": "frommen", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_72", "text": "Cristen, Die er Har \"fuͤr\"bringt / das einer ein Herzog", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_73", "text": "# darnach ermandten den Bychttiger, das er von den", "doc": "13922499"}
{"key": "A_V_1443_Hertwig_train/p0058/tr_1_tl_74", "text": "gelichnissen abstan / unnd by der schrifft belibe /", "doc": "13922499"}
