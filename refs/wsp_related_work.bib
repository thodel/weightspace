@misc{yang_cer-tpr_2026,
	title = {{CER}-{TPR}: {Quantifying} {Text}-{Context} {Bias} in {VLM}-{Based} {OCR}},
	url = {https://doi.org/10.2139/ssrn.7459957},
	doi = {10.2139/ssrn.7459957},
	abstract = {Vision-language models (VLMs) can perform OCR from images alone or together with external textual hints. Correct hints may repair visual recognition errors, whereas incorrect hints may override otherwise correct transcriptions. We study this reliability problem in cropped line- and word-level VLM OCR using a maritime document dataset and IIIT5K-Words. We evaluate realistic external OCR hints together with ground-truth and random-hint controls and independently generated one-edit and two-edit character corruptions, forming a conflict-conditioned evaluation of context benefit and risk. Exact Text Preference Ratio (Exact TPR), CER-based Text Preference Ratio (CER-TPR), and Preference Margin characterize source preference; CER-TPR provides character-level directional attribution for partially modified responses that exact source adoption leaves unresolved. External OCR context improves aggregate EM and CER for all four evaluated VLMs on both datasets, while incorrect hints induce model- and dataset-dependent errors. On Dataset A, Qwen3-VL 32B reaches a Correction Rate of 0.9255, whereas Mistral Small 3.2 reaches an Error Induction Rate of 0.5346. Among responses unresolved by Exact TPR, CER-TPR provides directional classification for 63.0\% on Dataset A and 79.2\% on Dataset B. These results show that textual context can deliver correction benefit and reliability risk, so OCR accuracy and source preference should be evaluated separately.},
	author = {Yang, Min-Seok and Seong, Ju-Hyeon},
	year = {2026},
	keywords = {abstract-only, input-perturbation, search-2026-11-06, text-context-bias, vlm-ocr, wsp-related-work},
}

