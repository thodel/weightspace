@misc{amirgaliyev_comparative_2026,
	title = {Comparative {Analysis} of {Explainable} {Artificial} {Intelligence} {Methods} for {Optical} {Character} {Recognition} of {Arabic} {Historical} {Manuscripts}},
	url = {https://doi.org/10.2139/ssrn.7664871},
	doi = {10.2139/ssrn.7664871},
	abstract = {This study focuses on the comparative analysis of architecture-independent Explainable Artificial Intelligence (XAI) methods applied to the task of Optical Character Recognition (OCR) in Arabic historical manuscripts. The research aims to evaluate the quality and consistency of explanation for various classes of neural networks, as well as to find ways to use XAI to diagnose and eliminate weaknesses in recognition models. Four architectures, namely CRNN-CTC, TrOCR-base, TrOCR-large, and Arabic Nougat, were evaluated in the study and trained on RASAM dataset. Occlusion Sensitivity, LIME, and KernelSHAP methods were used to interpret their decision. The quality of the explanations was analyzed using quantitative metrics such as Deletion AUC, Insertion AUC, AOPC, Spearman correlation, and stability index. The best-performing result was demonstrated by TrOCR-large model (CER=0.1618). The XAI analysis revealed fundamental differences between transformer models and CRNN-CTC in generation of significance maps. LIME and KernelSHAP methods showed the greatest mutual consistency. It was also conducted that Occlusion Sensitivity is most informative for transformers, while surrogate methods are most valuable for CRNN architectures. The investigation confirms the independent diagnostic values of XAI analysis to identify model limitations beyond the reach of standard accuracy metrics. Based on obtained significance maps, improvements to the basic CRNN-CTC model (SE-attention, positional coding, diacritics augmentation) were implemented, which increased Char F1 index by 9.7\%.},
	author = {Amirgaliyev, Beibut and Amilbek, Nurbolat and Yedilkhan, Didar and Tleuken, Aidana},
	year = {2026},
	keywords = {abstract-only, crnn-ctc, explainability, htr, search-2026-11-06, wsp-related-work, xai-comparison},
